{
  "name": "studyom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:sync": "vite build && cap sync",
    "mobile:open": "cap open android",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^8.2.2"
  },
  "productName": "STÜDYOM",
  "description": "STÜDYOM — Fotoğrafçılık & Stüdyo Yönetim Sistemi",
  "author": "STÜDYOM",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.studyom.app",
    "productName": "STÜDYOM",
    "executableName": "Studyom",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STÜDYOM",
      "artifactName": "Studyom-Kurulum-${version}.${ext}"
    }
  }
}
